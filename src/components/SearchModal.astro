---
import { url } from '../data/site';
---
<dialog class="search" id="search" aria-label="Search resources" transition:persist data-index={url('search-index.json')}>
  <div class="search-box">
    <div class="search-input">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="search-q" type="search" placeholder="Try: hook, review, spring, rewind…" autocomplete="off" spellcheck="false"
        role="combobox" aria-expanded="true" aria-controls="search-results" aria-autocomplete="list" />
      <kbd class="kbd">Esc</kbd>
    </div>
    <ul id="search-results" class="search-results" role="listbox" aria-label="Results"></ul>
    <p class="search-foot"><span><kbd class="kbd">↑</kbd> <kbd class="kbd">↓</kbd> move</span><span><kbd class="kbd">Enter</kbd> open</span><span class="search-count" aria-live="polite"></span><button type="button" class="ask-claude" data-ask-claude title="Copies your question and this site's catalogue, then opens claude.ai">Ask Claude ↗</button></p>
  </div>
</dialog>

<style is:global>
  dialog.search { padding: 0; border: 0; background: transparent; width: min(640px, calc(100vw - 32px)); max-height: min(560px, calc(100vh - 120px)); margin-top: 12vh; overflow: visible; color: var(--ink); }
  dialog.search::backdrop { background: rgba(28, 26, 23, 0.36); backdrop-filter: blur(3px); }
  dialog.search[open] .search-box { animation: search-in .32s cubic-bezier(.16,1,.3,1); }
  dialog.search[open]::backdrop { animation: fade-in .25s ease; }
  @keyframes search-in { from { opacity: 0; transform: translateY(-8px) scale(.97); } }
  @keyframes fade-in { from { opacity: 0; } }
  .search-box { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow-lift); overflow: hidden; display: flex; flex-direction: column; max-height: inherit; }
  .search-input { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--line); color: var(--muted); }
  .search-input input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: 500 17px/1.4 var(--sans); color: var(--ink); }
  .search-input input::-webkit-search-cancel-button { display: none; }
  .search-results { list-style: none; margin: 0; padding: 6px; overflow-y: auto; }
  .search-results a { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; padding: 10px 12px; border-radius: 8px; text-decoration: none; }
  .search-results a .t { font-weight: 600; }
  .search-results a .s { grid-column: 2; color: var(--muted); font-size: 14px; line-height: 1.4; }
  .search-results a .k { grid-row: span 2; align-self: start; margin-top: 2px; font: 500 11px/1 var(--mono); padding: 4px 6px; border-radius: 4px; background: var(--sunk); color: var(--muted); text-transform: uppercase; letter-spacing: .04em; min-width: 54px; text-align: center; }
  .search-results li[aria-selected='true'] a { background: var(--accent-soft); }
  .search-results li[aria-selected='true'] a .k { background: var(--accent); color: var(--accent-ink); }
  .search-results .empty { padding: 20px 12px; color: var(--muted); }
  .search-foot { display: flex; gap: 18px; padding: 10px 16px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
  .search-foot { align-items: center; }
  .search-count { margin-left: auto; }
  .ask-claude { font: 600 13px/1 var(--sans); color: var(--accent-ink); background: var(--accent); border: 0; border-radius: 999px; padding: 7px 12px; cursor: pointer; white-space: nowrap; }
  .ask-claude:hover { filter: brightness(1.08); }
  .ask-claude:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .search-results .empty .ask-claude { margin-left: 6px; }
  @media (max-width: 600px) { .search-foot span:not(.search-count) { display: none; } }
</style>
