---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import { TYPES, TYPE_KEYS, STACKS, STACK_KEYS, STACK_GROUPS, ORIGINS } from '../data/site';

interface Props { entries: CollectionEntry<'resources'>[]; hide?: ('type' | 'stack' | 'origin')[]; }
const { entries, hide = [] } = Astro.props;
const sorted = [...entries].sort((a, b) => TYPE_KEYS.indexOf(a.data.type) - TYPE_KEYS.indexOf(b.data.type) || a.data.title.localeCompare(b.data.title));
const groups = [
  { key: 'type', label: 'Type', options: TYPE_KEYS.map((k) => [k, TYPES[k].label]) },
  { key: 'stack', label: 'Stack', options: STACK_KEYS.filter((k) => k !== 'all').map((k) => [k, STACKS[k]]) },
  { key: 'origin', label: 'Made by', options: Object.entries(ORIGINS) },
].filter((g) => !hide.includes(g.key as any));
---
<div class="list">
  <form class="filters" data-filters aria-label="Filter resources">
    {groups.map((g) => (
      <fieldset>
        <legend>{g.label}</legend>
        <div class="opts">
          <label class="opt"><input type="radio" name={g.key} value="" checked /><span>All</span></label>
          {g.key === 'stack'
            ? STACK_GROUPS.map((sg) => (
                <span class="sgroup" role="group" aria-label={sg.label}>
                  <span class="sglabel" aria-hidden="true">{sg.label}</span>
                  {sg.stacks.map((v) => (
                    <label class="opt"><input type="radio" name="stack" value={v} /><span>{STACKS[v]}</span></label>
                  ))}
                </span>
              ))
            : g.options.map(([v, l]) => (
                <label class="opt"><input type="radio" name={g.key} value={v} /><span>{l}</span></label>
              ))}
        </div>
      </fieldset>
    ))}
    <div class="filter-bar">
      <p class="muted" data-filter-count aria-live="polite">{sorted.length} resources</p>
      <button type="reset" class="reset">Clear filters</button>
    </div>
  </form>
  <div class="grid" data-card-list>
    {sorted.map((e) => <Card entry={e} reveal={false} />)}
  </div>
  <p class="empty muted" data-filter-empty hidden>No resources match these filters yet. Clear one, or <a href="#" data-open-search>search instead</a>.</p>
</div>

<style>
  .filters { display: grid; gap: 14px; margin-bottom: 28px; padding: 18px 20px; border: 1px solid var(--line); border-radius: var(--r); background: var(--surface); }
  fieldset { border: 0; margin: 0; padding: 0; display: grid; grid-template-columns: 90px 1fr; gap: 12px; align-items: start; }
  legend { float: left; padding: 6px 0 0; font-size: 13px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
  .opts { display: flex; flex-wrap: wrap; gap: 6px; }
  .sgroup { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 6px; padding-left: 12px; margin-left: 4px; border-left: 1px solid var(--line); }
  .sglabel { font: 600 11px/1 var(--mono); color: var(--accent); text-transform: uppercase; letter-spacing: .05em; margin-right: 2px; }
  .opt { position: relative; cursor: pointer; }
  .opt input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .opt span { display: inline-block; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line); font-size: 14px; transition: background-color .2s, color .2s, border-color .2s; }
  .opt:hover span { border-color: var(--line-strong); background: var(--ground); }
  .opt input:checked + span { background: var(--ink); color: var(--ground); border-color: var(--ink); }
  .opt input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .filter-bar { display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid var(--line); }
  .reset { border: 0; background: none; color: var(--muted); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .reset:hover { color: var(--ink); }
  .empty { padding: 40px 0; }
  @media (max-width: 640px) { fieldset { grid-template-columns: minmax(0, 1fr); gap: 6px; } }
</style>
