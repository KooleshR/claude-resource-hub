---
import Base from '../layouts/Base.astro';
import { url } from '../data/site';

type Row = [string, string, string?];
const groups: { title: string; rows: Row[] }[] = [
  { title: 'Keys in a session', rows: [
    ['Esc', 'Stop Claude mid-step. Your conversation stays.'],
    ['Esc Esc', 'Rewind to an earlier prompt, code and conversation.', 'rewind'],
    ['Shift+Tab', 'Cycle permission modes, including plan mode.', 'plan-mode'],
    ['! command', 'Run a shell command yourself; the output goes into the conversation.'],
    ['@ path', 'Mention a file or folder so Claude reads it.'],
    ['/', 'Open the slash command list.'],
  ] },
  { title: 'Starting Claude Code', rows: [
    ['claude', 'Start a session in the current folder.', 'claude-code-cli'],
    ['claude --continue', 'Continue the last session in this folder.'],
    ['claude --resume', 'Pick an earlier session to resume.'],
    ['claude -p "prompt"', 'Run one prompt and exit (headless).', 'headless'],
    ['claude --permission-mode plan', 'Start in plan mode.', 'plan-mode'],
    ['claude --worktree name', 'Work in an isolated git worktree.'],
    ['claude mcp add --transport http name url', 'Add an MCP server. Add --scope project to share it.'],
  ] },
  { title: 'Commands you will use daily', rows: [
    ['/init', 'Write a starter CLAUDE.md.', 'init'],
    ['/clear', 'Fresh context for a new task.'],
    ['/compact', 'Summarise to free context.', 'compact'],
    ['/context', 'See what fills the context window.', 'context'],
    ['/rewind', 'Go back to a checkpoint.', 'rewind'],
    ['/code-review', 'Bug review of the diff, branch or PR.', 'code-review'],
    ['/model', 'Switch model.'],
    ['/memory', 'Edit CLAUDE.md files.', 'memory'],
    ['/plugin', 'Install plugins and marketplaces.', 'plugin'],
    ['/mcp', 'Manage MCP servers.'],
    ['/hooks', 'See which hooks are loaded.'],
    ['/doctor', 'Check the installation.'],
  ] },
  { title: 'Where things live', rows: [
    ['CLAUDE.md', 'Project instructions, read every session. Commit it.'],
    ['.claude/settings.json', 'Team settings: permissions, hooks. Commit it.'],
    ['.claude/settings.local.json', 'Your own overrides. Keep it out of git.'],
    ['.claude/agents/name.md', 'Project subagents.'],
    ['.claude/skills/name/SKILL.md', 'Project skills.'],
    ['~/.claude/', 'The same folders for you personally, across all projects.'],
  ] },
  { title: 'Hooks', rows: [
    ['exit 0', 'Carry on. Standard output may be added as context on some events.'],
    ['exit 2', 'Block the action. Standard error goes back to Claude.', 'block-dangerous-commands'],
    ['"matcher": "Bash|PowerShell"', 'Which tools a PreToolUse or PostToolUse hook watches. On Windows match both shells.'],
    ['${CLAUDE_PROJECT_DIR}', 'The project root, for hook script paths.'],
  ] },
];
---
<Base title="Cheatsheet" description="Claude Code keys, flags, daily commands, file locations and hook exit codes on one page.">
  <section class="page-head wrap">
    <h1 class="h1">Cheatsheet</h1>
    <p class="lead">The keys, flags and commands worth knowing by heart. Click a row with an arrow for the full page.</p>
  </section>
  <section class="wrap sheet" style="padding-bottom:96px">
    {groups.map((g) => (
      <section class="group" data-reveal>
        <h2>{g.title}</h2>
        <dl>
          {g.rows.map(([k, v, slug]) => (
            <div class="row">
              <dt><code>{k}</code></dt>
              <dd>{slug ? <a href={url(`resources/${slug}`)}>{v} <span aria-hidden="true">→</span></a> : v}</dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </section>
</Base>

<style>
  .sheet { columns: 2 460px; column-gap: 32px; }
  .group { break-inside: avoid; margin-bottom: 32px; padding: 20px 22px; border: 1px solid var(--line); border-radius: var(--r); background: var(--surface); }
  h2 { font-size: 1.125rem; font-stretch: 106%; margin-bottom: 12px; }
  dl { margin: 0; }
  .row { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 14px; padding: 9px 0; border-top: 1px solid var(--line); }
  dt code { padding: 2px 6px; border-radius: 4px; background: var(--sunk); font-size: 13px; overflow-wrap: anywhere; }
  dd { margin: 0; color: var(--muted); font-size: 15px; }
  dd a { color: var(--ink); text-decoration: none; }
  dd a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 520px) { .row { grid-template-columns: minmax(0, 1fr); gap: 4px; } }
</style>
