---
import Base from '../layouts/Base.astro';
import { url } from '../data/site';
---
<Base title="Not found">
  <section class="wrap nf">
    <p class="mono ev">PreToolUse · exit 2</p>
    <h1 class="display">Blocked.<br />This page doesn't exist.</h1>
    <p class="lead">The link may be old, or the resource moved. Search for it, or start from the list.</p>
    <p class="acts">
      <button type="button" class="btn" data-open-search>Search <span class="arrow" aria-hidden="true">→</span></button>
      <a class="btn ghost" href={url('resources')}>All resources</a>
    </p>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(64px, 12vw, 160px); }
  .ev { color: var(--accent); margin-bottom: 16px; }
  .lead { margin-top: 20px; }
  .acts { display: flex; gap: 10px; margin-top: 28px; flex-wrap: wrap; }
</style>
